extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug
block main
    +alertSuccess(4000)
    +alertError(4000)
    if (role.permissions.includes('accounts_edit'))  
        h1(class='mb-4') Chỉnh sửa tài khoản

        form(
            action=`${prefixadmin}/accounts/edit/${account.id}`
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group")
                label(for="title") Họ và tên 
                    span.text-danger *
                input(
                        type="text"
                        class="form-control"
                        id="fullName"
                        name="fullName"
                        value=account.fullName
                        required
                    )
            div(class="form-group")
                label(for="title") Email 
                    span.text-danger *
                input(
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        value=account.email
                        required
                    )
            div(class="form-group")
                label(for="title") Mật khẩu 
                    span.text-danger *
                input(
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                    )
            div(class="form-group")
                label(for="tel") Số điện thoại 
                    span.text-danger *
                input(
                        type="tel"
                        class="form-control"
                        id="phone"
                        name="phone"
                        value=account.phone
                        required
                    )
            div(
                class="form-group"
                upload-image
                )
                label(for="thumbnail") Avatar
                input(
                    type="file"
                    class="form-control-file"
                    style='cursor: pointer'
                    id="avatar"
                    name="avatar"
                    accept='image/*'
                    upload-image-input
                )
                img(
                    src=account.avatar
                    class='image-preview'
                    upload-image-preview
                )
            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked
                )
                label(for="statusActive" class="form-check-label") Hoạt động
            div(class="form-group form-check form-check-inline")
                input(
                        type="radio"
                        class="form-check-input"
                        id="statusInActive"
                        name="status"
                        value="inactive"
                    )
                label(for="statusInActive" class="form-check-label") Dừng hoạt động
            //-Phân quyền
            div(class="form-group")
                label(for="parent-id") Quyền
                select(
                    style='max-height: 50px;overflow-y: scroll'
                    name='role_id'
                    id='role_id'
                    class='form-control'
                )
                    option(value="") --Chọn quyền--
                    each item in roles
                        option(value=item.id selected=(currentRole.id == item.id ? true : false)) #{item.title} 
            div(class='form-group')
                button(
                    type='submit'
                    class='btn btn-primary'
                ) Cập nhật
        
