mixin table-tree(arr, level = 1)
  each item,index in arr
    - const prefix = Array(level + 1).join('-- ')
    tr
      td 
        input(
            type='checkbox'
            name="id"
            value=item.id
        )
      td #{item.index}
      td
        img(
        src=item.thumbnail
        alt=`${item.title}`
        width="100px"
        height="auto"
        )
      td #{prefix}#{item.title}
      td
        input(
            type='number'
            min=1
            name='position'
            style="width: 60px"
            value=item.position
        )
      td
        if (item.status == "active")
          a(
              href="javascript:;"
              data-status=item.status 
              data-id=item._id 
              button-change-status
              class="badge badge-success"
            
            ) Hoạt động
        else 
          a(
              href="javascript:;"
              data-status=item.status 
              data-id=item._id 
              button-change-status
              class="badge badge-danger") Dừng hoạt động
      td
        a(
            href=`${prefixadmin}/products-category/detail/${item._id}`
            class="btn btn-secondary btn-sm ml-1"
            data-id=item.id
            ) Chi tiết
        a(
            href=`${prefixadmin}/products-category/edit/${item._id}`
            class="btn btn-warning btn-sm ml-1"
            data-id=item.id
            ) Sửa
        button(
            class="btn btn-danger btn-sm ml-1"
            data-id=item.id
            button-delete
            ) Xóa
      if item.children && item.children.length > 0 
        +table-tree(item.children, level + 1) 